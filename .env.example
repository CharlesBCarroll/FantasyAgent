# --- Yahoo Fantasy API ---
# Create an app at https://developer.yahoo.com/apps/ (Fantasy Sports read permission).
# Run `python scripts/setup_yahoo_oauth.py` once to complete the OAuth flow and
# store the refresh token in secrets/yahoo_token.json. Client id/secret live here.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# --- ESPN Fantasy API ---
# Private leagues require cookies pulled from a logged-in browser session
# (DevTools -> Application/Storage -> Cookies on fantasy.espn.com):
#   espn_s2  -> ESPN_S2
#   SWID     -> ESPN_SWID (keep the surrounding curly braces)
# Public leagues can leave these blank.
ESPN_S2=
ESPN_SWID=

# --- FantasyPros API (optional third projection source) ---
# Request a free personal-use key at https://secure.fantasypros.com/api-keys/request/
# Leave blank to skip this source entirely — it fails gracefully either way.
FANTASYPROS_API_KEY=
